<?xml version="1.0"?>

<sdf version="1.10">

  <model name="traffic_light">

    <static>true</static>

    <link name="traffic_link">

      <!-- Cột -->
      <visual name="pole">
        <pose>0 0 2.0 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.08</radius>
            <length>4.0</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.12 0.12 0.12 1</diffuse>
        </material>
      </visual>

      <!-- Hộp đèn -->
      <visual name="housing">
        <pose>0 0 3.55 0 0 0</pose>
        <geometry>
          <box>
            <size>0.35 0.25 1.0</size>
          </box>
        </geometry>
        <material>
          <ambient>0.04 0.04 0.04 1</ambient>
          <diffuse>0.06 0.06 0.06 1</diffuse>
        </material>
      </visual>

      <!-- Đỏ -->
      <visual name="red_light">
        <pose>0 -0.14 3.85 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.09</radius>
            <length>0.03</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.9 0.05 0.05 1</ambient>
          <diffuse>1.0 0.05 0.05 1</diffuse>
          <emissive>0.7 0.0 0.0 1</emissive>
        </material>
      </visual>

      <!-- Vàng -->
      <visual name="yellow_light">
        <pose>0 -0.14 3.55 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.09</radius>
            <length>0.03</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.9 0.7 0.05 1</ambient>
          <diffuse>1.0 0.8 0.05 1</diffuse>
          <emissive>0.7 0.5 0.0 1</emissive>
        </material>
      </visual>

      <!-- Xanh -->
      <visual name="green_light">
        <pose>0 -0.14 3.25 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.09</radius>
            <length>0.03</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.05 0.8 0.15 1</ambient>
          <diffuse>0.05 1.0 0.20 1</diffuse>
          <emissive>0.0 0.7 0.05 1</emissive>
        </material>
      </visual>

    </link>

  </model>

</sdf>