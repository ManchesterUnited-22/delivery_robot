        </geometry>

        <material>
          <ambient>0.08 0.35 0.55 1</ambient>
          <diffuse>0.12 0.45 0.70 1</diffuse>
        </material>

      </visual>


      <!-- =========================
           CỬA KÍNH MẶT TRƯỚC - TẦNG 3
           ========================= -->

