<?xml version="1.0"?>

<sdf version="1.10">

  <model name="building">

    <static>true</static>

    <!-- =========================
         COLLISION
         ========================= -->

    <link name="building_link">

      <collision name="collision">

        <geometry>
          <box>
            <size>4 4 4</size>
          </box>
        </geometry>

      </collision>

      <!-- =========================
           THÂN TÒA NHÀ
           ========================= -->

      <visual name="building_body">

        <geometry>
          <box>
            <size>4 4 4</size>
          </box>
        </geometry>

        <material>
          <ambient>0.55 0.58 0.62 1</ambient>
          <diffuse>0.65 0.68 0.72 1</diffuse>
        </material>

      </visual>


      <!-- =========================
           CỬA KÍNH MẶT TRƯỚC - TẦNG 1
           ========================= -->

      <visual name="window_front_1">

        <pose>0 -2.01 -1.2 0 0 0</pose>

        <geometry>
          <box>
            <size>1.0 0.04 0.9</size>
          </box>
        </geometry>

        <material>
          <ambient>0.08 0.35 0.55 1</ambient>
          <diffuse>0.12 0.45 0.70 1</diffuse>
        </material>

      </visual>


      <!-- =========================
           CỬA KÍNH MẶT TRƯỚC - TẦNG 2
