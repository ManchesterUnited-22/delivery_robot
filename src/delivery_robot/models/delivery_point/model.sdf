<?xml version="1.0"?>

<sdf version="1.10">

  <model name="delivery_point">

    <static>true</static>

    <link name="delivery_link">

      <!-- =========================
           NỀN KHU GIAO HÀNG
           ========================= -->

      <visual name="delivery_area">

        <pose>0 0 0.015 0 0 0</pose>

        <geometry>
          <box>
            <size>3 3 0.03</size>
          </box>
        </geometry>

        <material>
          <ambient>0.10 0.55 0.20 1</ambient>
          <diffuse>0.15 0.70 0.25 1</diffuse>
        </material>

      </visual>


      <!-- =========================
           CỘT ĐÁNH DẤU
           ========================= -->

      <visual name="marker">

        <pose>0 0 0.6 0 0 0</pose>

        <geometry>
          <box>
            <size>0.15 0.15 1.2</size>
          </box>
        </geometry>

        <material>
          <ambient>0.95 0.75 0.05 1</ambient>
          <diffuse>1.0 0.85 0.10 1</diffuse>
        </material>

      </visual>


      <!-- =========================
           MẶT TRÊN CỘT
           ========================= -->

      <visual name="marker_top">

        <pose>0 0 1.25 0 0 0</pose>

        <geometry>
          <box>
            <size>0.5 0.5 0.15</size>
          </box>
        </geometry>

        <material>
          <ambient>0.95 0.75 0.05 1</ambient>
          <diffuse>1.0 0.85 0.10 1</diffuse>
        </material>

      </visual>

    </link>

  </model>

</sdf>