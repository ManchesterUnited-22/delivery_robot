<?xml version="1.0"?>

<sdf version="1.10">

  <model name="road">

    <static>true</static>

    <link name="road_link">

      <visual name="road_visual">

        <pose>0 0 0.01 0 0 0</pose>

        <geometry>
          <box>
            <size>60 5 0.02</size>
          </box>
        </geometry>

        <material>
          <ambient>0.12 0.12 0.12 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>

      </visual>

    </link>

  </model>

</sdf>