<?xml version="1.0"?>

<sdf version="1.10">

  <model name="building_2">

    <static>true</static>

    <link name="building_link">

      <!-- =========================
           COLLISION
           ========================= -->

      <collision name="collision">

        <geometry>
          <box>
            <size>4.5 4 3.2</size>
          </box>
        </geometry>

      </collision>


      <!-- =========================
           THÂN NHÀ
           ========================= -->

      <visual name="body">

        <geometry>
          <box>
            <size>4.5 4 3.2</size>
          </box>
        </geometry>

        <material>
          <ambient>0.75 0.75 0.72 1</ambient>
          <diffuse>0.85 0.85 0.82 1</diffuse>
        </material>

      </visual>


      <!-- =========================
           KÍNH TẦNG 1
           MẶT +Y - HƯỚNG VÀO ĐƯỜNG
           ========================= -->

      <visual name="glass_1">

        <pose>0 2.01 -0.65 0 0 0</pose>

        <geometry>
          <box>
            <size>3.4 0.04 0.75</size>
          </box>
        </geometry>

        <material>
          <ambient>0.08 0.35 0.55 1</ambient>
          <diffuse>0.12 0.48 0.72 1</diffuse>
        </material>

      </visual>


      <!-- =========================
           KÍNH TẦNG 2
           ========================= -->

      <visual name="glass_2">

        <pose>0 2.01 0.85 0 0 0</pose>

        <geometry>
          <box>
            <size>3.4 0.04 0.75</size>
          </box>
        </geometry>

        <material>
          <ambient>0.08 0.35 0.55 1</ambient>
          <diffuse>0.12 0.48 0.72 1</diffuse>
        </material>

      </visual>


      <!-- =========================
           CỬA RA VÀO
           MẶT +Y
           ========================= -->

      <visual name="entrance">

        <pose>1.25 2.03 -1.0 0 0 0</pose>

        <geometry>
          <box>
            <size>0.8 0.05 1.3</size>
          </box>
        </geometry>

        <material>
          <ambient>0.20 0.12 0.07 1</ambient>
          <diffuse>0.28 0.16 0.08 1</diffuse>
        </material>

      </visual>


      <!-- =========================
           MÁI
           ========================= -->

      <visual name="roof">

        <pose>0 0 1.7 0 0 0</pose>

        <geometry>
          <box>
            <size>4.8 4.3 0.2</size>
          </box>
        </geometry>

        <material>
          <ambient>0.18 0.20 0.22 1</ambient>
          <diffuse>0.22 0.24 0.27 1</diffuse>
        </material>

      </visual>


      <!-- =========================
           VIỀN GIỮA CÁC TẦNG
           MẶT +Y
           ========================= -->

      <visual name="floor_band">

        <pose>0 2.04 0.05 0 0 0</pose>

        <geometry>
          <box>
            <size>4.5 0.08 0.12</size>
          </box>
        </geometry>

        <material>
          <ambient>0.25 0.27 0.30 1</ambient>
          <diffuse>0.30 0.32 0.35 1</diffuse>
        </material>

