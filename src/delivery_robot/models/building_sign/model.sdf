<?xml version="1.0"?>

<sdf version="1.10">

  <model name="building_sign">

    <static>true</static>

    <link name="sign_link">

      <visual name="sign">
        <pose>0 0 2.3 0 0 0</pose>

        <geometry>
          <box>
            <size>2.4 0.12 0.6</size>
          </box>
        </geometry>

        <material>
          <ambient>0.05 0.25 0.55 1</ambient>
          <diffuse>0.08 0.35 0.75 1</diffuse>
        </material>
      </visual>

      <visual name="sign_top">
        <pose>0 0 2.62 0 0 0</pose>

        <geometry>
          <box>
            <size>2.5 0.08 0.08</size>
          </box>
        </geometry>

        <material>
          <ambient>0.85 0.85 0.85 1</ambient>
          <diffuse>0.95 0.95 0.95 1</diffuse>
        </material>
      </visual>

    </link>

  </model>

</sdf>