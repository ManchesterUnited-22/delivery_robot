<?xml version="1.0"?>

<sdf version="1.10">

  <model name="road_marking">

    <static>true</static>

    <link name="marking_link">

      <!-- Vạch giữa đường -->
      <visual name="center_line">
        <pose>0 0 0.025 0 0 0</pose>

        <geometry>
          <box>
            <size>1.2 0.12 0.01</size>
          </box>
        </geometry>

        <material>
          <ambient>0.9 0.9 0.9 1</ambient>
          <diffuse>1.0 1.0 1.0 1</diffuse>
        </material>
      </visual>

    </link>

  </model>

</sdf>