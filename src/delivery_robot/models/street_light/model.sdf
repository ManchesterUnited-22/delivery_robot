<?xml version="1.0"?>

<sdf version="1.10">

  <model name="street_light">

    <static>true</static>

    <link name="light_link">

      <!-- Cột -->
      <visual name="pole">
        <pose>0 0 1.75 0 0 0</pose>

        <geometry>
          <cylinder>
            <radius>0.08</radius>
            <length>3.5</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.20 0.20 0.20 1</diffuse>
        </material>
      </visual>

      <!-- Thanh ngang phía trên -->
      <visual name="arm">
        <pose>0.35 0 3.45 0 0 0</pose>

        <geometry>
          <box>
            <size>0.7 0.08 0.08</size>
          </box>
        </geometry>

        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.20 0.20 0.20 1</diffuse>
        </material>
      </visual>

      <!-- Bóng đèn -->
      <visual name="lamp">
        <pose>0.68 0 3.38 0 0 0</pose>

        <geometry>
          <sphere>
            <radius>0.18</radius>
          </sphere>
        </geometry>

        <material>
          <ambient>1.0 0.85 0.30 1</ambient>
          <diffuse>1.0 0.90 0.45 1</diffuse>
          <emissive>0.8 0.6 0.2 1</emissive>
        </material>

      </visual>

      <!-- Đế -->
      <visual name="base">
        <pose>0 0 0.08 0 0 0</pose>

        <geometry>
          <cylinder>
            <radius>0.18</radius>
            <length>0.16</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.10 0.10 0.10 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>

    </link>

  </model>

</sdf>