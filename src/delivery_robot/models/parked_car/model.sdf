<?xml version="1.0"?>

<sdf version="1.10">

  <model name="parked_car">

    <static>true</static>

    <link name="car_link">

      <!-- Thân xe -->
      <visual name="body">
        <pose>0 0 0.45 0 0 0</pose>
        <geometry>
          <box>
            <size>2.2 1.1 0.7</size>
          </box>
        </geometry>
        <material>
          <ambient>0.10 0.25 0.55 1</ambient>
          <diffuse>0.15 0.35 0.75 1</diffuse>
        </material>
      </visual>

      <!-- Cabin -->
      <visual name="cabin">
        <pose>-0.15 0 0.9 0 0 0</pose>
        <geometry>
          <box>
            <size>1.2 0.9 0.5</size>
          </box>
        </geometry>
        <material>
          <ambient>0.08 0.10 0.12 1</ambient>
          <diffuse>0.12 0.16 0.20 1</diffuse>
        </material>
      </visual>

      <!-- Kính trước -->
      <visual name="front_window">
        <pose>0.48 0 0.92 0 0 0</pose>
        <geometry>
          <box>
            <size>0.03 0.65 0.3</size>
          </box>
        </geometry>
        <material>
          <ambient>0.05 0.20 0.30 1</ambient>
          <diffuse>0.08 0.35 0.50 1</diffuse>
        </material>
      </visual>

      <!-- Bánh trước -->
      <visual name="wheel_fl">
        <pose>0.65 0.58 0.3 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.3</radius>
            <length>0.15</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.03 0.03 0.03 1</ambient>
          <diffuse>0.04 0.04 0.04 1</diffuse>
        </material>
      </visual>

      <visual name="wheel_fr">
        <pose>0.65 -0.58 0.3 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.3</radius>
            <length>0.15</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.03 0.03 0.03 1</ambient>
          <diffuse>0.04 0.04 0.04 1</diffuse>
        </material>
      </visual>

      <!-- Bánh sau -->
      <visual name="wheel_rl">
        <pose>-0.65 0.58 0.3 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.3</radius>
            <length>0.15</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.03 0.03 0.03 1</ambient>
          <diffuse>0.04 0.04 0.04 1</diffuse>
        </material>
      </visual>

      <visual name="wheel_rr">
        <pose>-0.65 -0.58 0.3 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.3</radius>
            <length>0.15</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.03 0.03 0.03 1</ambient>
          <diffuse>0.04 0.04 0.04 1</diffuse>
        </material>
      </visual>

      <!-- Collision -->
      <collision name="collision">
        <geometry>
          <box>
            <size>2.2 1.1 0.9</size>
          </box>
        </geometry>
      </collision>

    </link>

  </model>

</sdf>