      </visual>
      <collision name="front_left_wheel_collision"><geometry><cylinder><radius>0.15</radius><length>0.10</length></cylinder></geometry></collision>
      <inertial><mass>1.0</mass><inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz><ixy>0.0</ixy><ixz>0.0</ixz><iyz>0.0</iyz></inertia></inertial>
    </link>

    <link name="front_right_wheel">
      <pose relative_to="front_right_steering">0 0 0 1.5708 0 0</pose>
      <visual name="front_right_wheel_visual">
        <geometry><cylinder><radius>0.15</radius><length>0.10</length></cylinder></geometry>
        <material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.04 0.04 0.04 1</diffuse><specular>0.3 0.3 0.3 1</specular><shininess>0.4</shininess></material>
      </visual>
      <visual name="front_right_rim">
        <pose>0 0 0.052 0 0 0</pose>
        <geometry><cylinder><radius>0.085</radius><length>0.006</length></cylinder></geometry>
        <material><ambient>0.55 0.58 0.62 1</ambient><diffuse>0.72 0.75 0.80 1</diffuse><specular>0.4 0.4 0.4 1</specular></material>
      </visual>
      <collision name="front_right_wheel_collision"><geometry><cylinder><radius>0.15</radius><length>0.10</length></cylinder></geometry></collision>
      <inertial><mass>1.0</mass><inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz><ixy>0.0</ixy><ixz>0.0</ixz><iyz>0.0</iyz></inertia></inertial>
    </link>

    <link name="rear_left_wheel">
      <pose>-0.35 0.34 0.15 1.5708 0 0</pose>
      <visual name="rear_left_wheel_visual">
        <geometry><cylinder><radius>0.15</radius><length>0.10</length></cylinder></geometry>
        <material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.04 0.04 0.04 1</diffuse><specular>0.3 0.3 0.3 1</specular><shininess>0.4</shininess></material>
      </visual>
      <visual name="rear_left_rim">
        <pose>0 0 -0.052 0 0 0</pose>
        <geometry><cylinder><radius>0.085</radius><length>0.006</length></cylinder></geometry>
        <material><ambient>0.55 0.58 0.62 1</ambient><diffuse>0.72 0.75 0.80 1</diffuse><specular>0.4 0.4 0.4 1</specular></material>
      </visual>
      <collision name="rear_left_wheel_collision"><geometry><cylinder><radius>0.15</radius><length>0.10</length></cylinder></geometry></collision>
      <inertial><mass>1.0</mass><inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz><ixy>0.0</ixy><ixz>0.0</ixz><iyz>0.0</iyz></inertia></inertial>
    </link>

    <link name="rear_right_wheel">
      <pose>-0.35 -0.34 0.15 1.5708 0 0</pose>
      <visual name="rear_right_wheel_visual">
        <geometry><cylinder><radius>0.15</radius><length>0.10</length></cylinder></geometry>
        <material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.04 0.04 0.04 1</diffuse><specular>0.3 0.3 0.3 1</specular><shininess>0.4</shininess></material>
      </visual>
      <visual name="rear_right_rim">
        <pose>0 0 0.052 0 0 0</pose>
        <geometry><cylinder><radius>0.085</radius><length>0.006</length></cylinder></geometry>
        <material><ambient>0.55 0.58 0.62 1</ambient><diffuse>0.72 0.75 0.80 1</diffuse><specular>0.4 0.4 0.4 1</specular></material>
      </visual>
      <collision name="rear_right_wheel_collision"><geometry><cylinder><radius>0.15</radius><length>0.10</length></cylinder></geometry></collision>
      <inertial><mass>1.0</mass><inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz><ixy>0.0</ixy><ixz>0.0</ixz><iyz>0.0</iyz></inertia></inertial>
    </link>

    <!-- Joints -->
    <joint name="front_left_steering_joint" type="revolute">
      <parent>chassis</parent><child>front_left_steering</child>
      <pose>0 0 0 0 0 0</pose>
      <axis><xyz>0 0 1</xyz><limit><lower>-0.5</lower><upper>0.5</upper><effort>1000000</effort></limit></axis>
    </joint>
    <joint name="front_right_steering_joint" type="revolute">
      <parent>chassis</parent><child>front_right_steering</child>
      <pose>0 0 0 0 0 0</pose>
      <axis><xyz>0 0 1</xyz><limit><lower>-0.5</lower><upper>0.5</upper><effort>1000000</effort></limit></axis>
    </joint>
    <joint name="front_left_joint" type="revolute">
      <parent>front_left_steering</parent><child>front_left_wheel</child>
      <pose>0 0 0 0 0 0</pose>
      <axis><xyz>0 0 -1</xyz></axis>
    </joint>
    <joint name="front_right_joint" type="revolute">
      <parent>front_right_steering</parent><child>front_right_wheel</child>
      <pose>0 0 0 0 0 0</pose>
      <axis><xyz>0 0 -1</xyz></axis>
    </joint>
    <joint name="rear_left_joint" type="revolute">
      <parent>chassis</parent><child>rear_left_wheel</child>
      <pose>0 0 0 0 0 0</pose>
      <axis><xyz>0 0 -1</xyz></axis>
    </joint>
    <joint name="rear_right_joint" type="revolute">
      <parent>chassis</parent><child>rear_right_wheel</child>
      <pose>0 0 0 0 0 0</pose>
      <axis><xyz>0 0 -1</xyz></axis>
    </joint>

    <!-- Ackermann -->
    <plugin filename="gz-sim-ackermann-steering-system" name="gz::sim::systems::AckermannSteering">
      <left_joint>rear_left_joint</left_joint>
      <right_joint>rear_right_joint</right_joint>
      <left_steering_joint>front_left_steering_joint</left_steering_joint>
      <right_steering_joint>front_right_steering_joint</right_steering_joint>
      <wheel_separation>0.68</wheel_separation>
      <wheel_base>0.70</wheel_base>
      <wheel_radius>0.15</wheel_radius>
      <steering_limit>0.5</steering_limit>
      <min_velocity>-1.0</min_velocity>
      <max_velocity>1.0</max_velocity>
      <topic>/cmd_vel</topic>
    </plugin>

    <!-- Sensors (unchanged) -->
    <link name="lidar_link">
      <pose>0.25 0 1.00 0 0 0</pose>
      <sensor name="lidar" type="gpu_lidar">
        <topic>/scan</topic>
        <update_rate>10</update_rate>
        <ray>
          <scan><horizontal>
            <samples>360</samples><resolution>1</resolution>
            <min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle>
          </horizontal></scan>
          <range><min>0.10</min><max>10.0</max><resolution>0.01</resolution></range>
        </ray>
        <always_on>true</always_on>
        <visualize>true</visualize>
      </sensor>
    </link>
    <joint name="lidar_joint" type="fixed"><parent>chassis</parent><child>lidar_link</child></joint>

    <link name="imu_link">
      <pose>0 0 0.55 0 0 0</pose>
      <sensor name="imu_sensor" type="imu">
        <topic>/imu</topic>
        <always_on>true</always_on>
        <update_rate>50</update_rate>
        <visualize>false</visualize>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0.0</mean><stddev>0.001</stddev></noise></x>
            <y><noise type="gaussian"><mean>0.0</mean><stddev>0.001</stddev></noise></y>
            <z><noise type="gaussian"><mean>0.0</mean><stddev>0.001</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise></x>
            <y><noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise></y>
            <z><noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>
    </link>
    <joint name="imu_joint" type="fixed"><parent>chassis</parent><child>imu_link</child></joint>

    <link name="camera_link">
      <pose>0.45 0 0.65 0 0 0</pose>
      <sensor name="camera" type="camera">
        <topic>/camera/image_raw</topic>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.1</near><far>30.0</far></clip>
        </camera>
      </sensor>
    </link>
    <joint name="camera_joint" type="fixed"><parent>chassis</parent><child>camera_link</child></joint>

    <link name="gps_link">
      <pose>0 0 0.75 0 0 0</pose>
      <sensor name="gps_sensor" type="navsat">
        <topic>/gps</topic>
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <visualize>false</visualize>
      </sensor>
    </link>
    <joint name="gps_joint" type="fixed"><parent>chassis</parent><child>gps_link</child></joint>

    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_topic>/model/delivery_robot/odometry</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <dimensions>3</dimensions>
    </plugin>

  </model>
</sdf>
