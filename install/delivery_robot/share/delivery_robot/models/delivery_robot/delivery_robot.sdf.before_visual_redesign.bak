<?xml version="1.0"?>
<sdf version="1.10">

  <model name="delivery_robot">

    <!-- ========================================================= -->
    <!-- CHASSIS                                                   -->
    <!-- ========================================================= -->
    <link name="chassis">

      <pose>0 0 0.30 0 0 0</pose>

      <!-- Thân xe chính -->
      <visual name="chassis_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>1.05 0.64 0.22</size>
          </box>
        </geometry>
        <material>
          <ambient>0.05 0.25 0.65 1</ambient>
          <diffuse>0.08 0.35 0.85 1</diffuse>
        </material>
      </visual>

      <!-- Thân trên phía trước -->
      <visual name="upper_body">
        <pose>0.18 0 0.20 0 0 0</pose>
        <geometry>
          <box>
            <size>0.55 0.56 0.20</size>
          </box>
        </geometry>
        <material>
          <ambient>0.08 0.10 0.13 1</ambient>
          <diffuse>0.12 0.15 0.20 1</diffuse>
        </material>
      </visual>

      <!-- =========================
           KHOANG CHỨA HÀNG (THÙNG KÍN)
           ========================= -->

      <!-- Đáy khoang -->
      <visual name="cargo_floor">
        <pose>-0.20 0 0.235 0 0 0</pose>
        <geometry>
          <box>
            <size>0.58 0.56 0.04</size>
          </box>
        </geometry>
        <material>
          <ambient>0.72 0.74 0.78 1</ambient>
          <diffuse>0.82 0.84 0.88 1</diffuse>
        </material>
      </visual>

      <!-- Vách trước -->
      <visual name="cargo_front_wall">
        <pose>0.09 0 0.50 0 0 0</pose>
        <geometry>
          <box>
            <size>0.04 0.56 0.55</size>
          </box>
        </geometry>
        <material>
          <ambient>0.72 0.74 0.78 1</ambient>
          <diffuse>0.82 0.84 0.88 1</diffuse>
        </material>
      </visual>

      <!-- Vách sau -->
      <visual name="cargo_rear_wall">
        <pose>-0.49 0 0.50 0 0 0</pose>
        <geometry>
          <box>
            <size>0.04 0.56 0.55</size>
          </box>
        </geometry>
        <material>
          <ambient>0.72 0.74 0.78 1</ambient>
          <diffuse>0.82 0.84 0.88 1</diffuse>
        </material>
      </visual>

      <!-- Vách hông TRÁI (cố định) -->
      <visual name="cargo_left_wall">
        <pose>-0.20 0.2925 0.50 0 0 0</pose>
        <geometry>
          <box>
            <size>0.58 0.025 0.55</size>
          </box>
        </geometry>
        <material>
          <ambient>0.72 0.74 0.78 1</ambient>
          <diffuse>0.82 0.84 0.88 1</diffuse>
        </material>
      </visual>

      <!-- Vách hông PHẢI (cố định) -->
      <visual name="cargo_right_wall">
        <pose>-0.20 -0.2925 0.50 0 0 0</pose>
        <geometry>
          <box>
            <size>0.58 0.025 0.55</size>
          </box>
        </geometry>
        <material>
          <ambient>0.72 0.74 0.78 1</ambient>
          <diffuse>0.82 0.84 0.88 1</diffuse>
        </material>
      </visual>

      <!-- Nóc khoang -->
      <visual name="cargo_roof">
        <pose>-0.20 0 0.80 0 0 0</pose>
        <geometry>
          <box>
            <size>0.64 0.60 0.08</size>
          </box>
        </geometry>
        <material>
          <ambient>0.08 0.10 0.13 1</ambient>
          <diffuse>0.12 0.15 0.20 1</diffuse>
        </material>
      </visual>

      <!-- Thanh trạng thái trên nóc -->
      <visual name="status_light">
        <pose>0.12 0 0.34 0 0 0</pose>
        <geometry>
          <box>
            <size>0.32 0.08 0.05</size>
          </box>
        </geometry>
        <material>
          <ambient>0.05 0.80 0.20 1</ambient>
          <diffuse>0.10 1.0 0.30 1</diffuse>
          <emissive>0.05 0.50 0.10 1</emissive>
        </material>
      </visual>

      <!-- Logo phía trước -->
      <visual name="delivery_logo">
        <pose>0.455 0 0.30 0 0 0</pose>
        <geometry>
          <box>
            <size>0.025 0.32 0.12</size>
          </box>
        </geometry>
        <material>
          <ambient>0.90 0.65 0.05 1</ambient>
          <diffuse>1.0 0.80 0.10 1</diffuse>
        </material>
      </visual>

      <!-- Collision -->
      <collision name="chassis_collision">
        <geometry>
          <box>
            <size>0.9 0.6 0.2</size>
          </box>
        </geometry>
      </collision>

      <inertial>
        <mass>10.0</mass>
        <inertia>
          <ixx>1.0</ixx>
          <iyy>1.0</iyy>
          <izz>1.0</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>

    </link>

    <!-- ========================================================= -->
    <!-- KIỆN HÀNG 1                                               -->
    <!-- ========================================================= -->
    <link name="package_1">
      <pose>-0.20 0 0.48 0 0 0</pose>

      <visual name="package_1_visual">
        <geometry>
          <box>
            <size>0.22 0.22 0.20</size>
          </box>
        </geometry>
        <material>
          <ambient>0.85 0.55 0.12 1</ambient>
          <diffuse>1.0 0.70 0.20 1</diffuse>
        </material>
      </visual>

      <collision name="package_1_collision">
        <geometry>
          <box>
            <size>0.22 0.22 0.20</size>
          </box>
        </geometry>
      </collision>

      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.005</ixx>
          <iyy>0.005</iyy>
          <izz>0.005</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
    </link>

    <joint name="package_1_joint" type="fixed">
      <parent>chassis</parent>
      <child>package_1</child>
    </joint>

    <!-- ========================================================= -->
    <!-- KIỆN HÀNG 2                                               -->
    <!-- ========================================================= -->
    <link name="package_2">
      <pose>-0.36 0.14 0.48 0 0 0</pose>

      <visual name="package_2_visual">
        <geometry>
          <box>
            <size>0.20 0.20 0.18</size>
          </box>
        </geometry>
        <material>
          <ambient>0.15 0.45 0.75 1</ambient>
          <diffuse>0.20 0.60 0.90 1</diffuse>
        </material>
      </visual>

      <collision name="package_2_collision">
        <geometry>
          <box>
            <size>0.20 0.20 0.18</size>
          </box>
        </geometry>
      </collision>

      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.004</ixx>
          <iyy>0.004</iyy>
          <izz>0.004</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
    </link>

    <joint name="package_2_joint" type="fixed">
      <parent>chassis</parent>
      <child>package_2</child>
    </joint>

    <!-- ========================================================= -->
    <!-- KIỆN HÀNG 3                                               -->
    <!-- ========================================================= -->
    <link name="package_3">
      <pose>-0.05 -0.14 0.48 0 0 0</pose>

      <visual name="package_3_visual">
        <geometry>
          <box>
            <size>0.20 0.20 0.18</size>
          </box>
        </geometry>
        <material>
          <ambient>0.55 0.20 0.70 1</ambient>
          <diffuse>0.70 0.30 0.85 1</diffuse>
        </material>
      </visual>

      <collision name="package_3_collision">
        <geometry>
          <box>
            <size>0.20 0.20 0.18</size>
          </box>
        </geometry>
      </collision>

      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.004</ixx>
          <iyy>0.004</iyy>
          <izz>0.004</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
    </link>

    <joint name="package_3_joint" type="fixed">
      <parent>chassis</parent>
      <child>package_3</child>
    </joint>

    <!-- ========================================================= -->
    <!-- FRONT LEFT STEERING KNUCKLE                               -->
    <!-- ========================================================= -->
    <link name="front_left_steering">
      <pose>0.35 0.34 0.15 0 0 0</pose>
      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.001</ixx>
          <iyy>0.001</iyy>
          <izz>0.001</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>
    </link>

    <!-- ========================================================= -->
    <!-- FRONT RIGHT STEERING KNUCKLE                              -->
    <!-- ========================================================= -->
    <link name="front_right_steering">
      <pose>0.35 -0.34 0.15 0 0 0</pose>
      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.001</ixx>
          <iyy>0.001</iyy>
          <izz>0.001</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>
    </link>

    <!-- ========================================================= -->
    <!-- FRONT LEFT WHEEL                                          -->
    <!-- ========================================================= -->
    <link name="front_left_wheel">
      <pose relative_to="front_left_steering">0 0 0 1.5708 0 0</pose>

      <visual name="front_left_wheel_visual">
        <geometry>
          <cylinder>
            <radius>0.15</radius>
            <length>0.10</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.02 0.02 0.02 1</ambient>
          <diffuse>0.04 0.04 0.04 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
          <shininess>0.4</shininess>
        </material>
      </visual>

      <collision name="front_left_wheel_collision">
        <geometry>
          <cylinder>
            <radius>0.15</radius>
            <length>0.10</length>
          </cylinder>
        </geometry>
      </collision>

      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.01</ixx>
          <iyy>0.01</iyy>
          <izz>0.01</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>
    </link>

    <!-- ========================================================= -->
    <!-- FRONT RIGHT WHEEL                                         -->
    <!-- ========================================================= -->
    <link name="front_right_wheel">
      <pose relative_to="front_right_steering">0 0 0 1.5708 0 0</pose>

      <visual name="front_right_wheel_visual">
        <geometry>
          <cylinder>
            <radius>0.15</radius>
            <length>0.10</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.02 0.02 0.02 1</ambient>
          <diffuse>0.04 0.04 0.04 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
          <shininess>0.4</shininess>
        </material>
      </visual>

      <collision name="front_right_wheel_collision">
        <geometry>
          <cylinder>
            <radius>0.15</radius>
            <length>0.10</length>
          </cylinder>
        </geometry>
      </collision>

      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.01</ixx>
          <iyy>0.01</iyy>
          <izz>0.01</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>
    </link>

    <!-- ========================================================= -->
    <!-- REAR LEFT WHEEL                                           -->
    <!-- ========================================================= -->
    <link name="rear_left_wheel">
      <pose>-0.35 0.34 0.15 1.5708 0 0</pose>

      <visual name="rear_left_wheel_visual">
        <geometry>
          <cylinder>
            <radius>0.15</radius>
            <length>0.10</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.02 0.02 0.02 1</ambient>
          <diffuse>0.04 0.04 0.04 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
          <shininess>0.4</shininess>
        </material>
      </visual>

      <collision name="rear_left_wheel_collision">
        <geometry>
          <cylinder>
            <radius>0.15</radius>
            <length>0.10</length>
          </cylinder>
        </geometry>
      </collision>

      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.01</ixx>
          <iyy>0.01</iyy>
          <izz>0.01</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>
    </link>

    <!-- ========================================================= -->
    <!-- REAR RIGHT WHEEL                                          -->
    <!-- ========================================================= -->
    <link name="rear_right_wheel">
      <pose>-0.35 -0.34 0.15 1.5708 0 0</pose>

      <visual name="rear_right_wheel_visual">
        <geometry>
          <cylinder>
            <radius>0.15</radius>
            <length>0.10</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.02 0.02 0.02 1</ambient>
          <diffuse>0.04 0.04 0.04 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
          <shininess>0.4</shininess>
        </material>
      </visual>

      <collision name="rear_right_wheel_collision">
        <geometry>
          <cylinder>
            <radius>0.15</radius>
            <length>0.10</length>
          </cylinder>
        </geometry>
      </collision>

      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.01</ixx>
          <iyy>0.01</iyy>
          <izz>0.01</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>
    </link>

    <!-- ========================================================= -->
    <!-- JOINTS                                                    -->
    <!-- ========================================================= -->

    <joint name="front_left_steering_joint" type="revolute">
      <parent>chassis</parent>
      <child>front_left_steering</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-0.5</lower>
          <upper>0.5</upper>
          <effort>1000000</effort>
        </limit>
      </axis>
    </joint>

    <joint name="front_right_steering_joint" type="revolute">
      <parent>chassis</parent>
      <child>front_right_steering</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-0.5</lower>
          <upper>0.5</upper>
          <effort>1000000</effort>
        </limit>
      </axis>
    </joint>

    <joint name="front_left_joint" type="revolute">
      <parent>front_left_steering</parent>
      <child>front_left_wheel</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 0 -1</xyz>
      </axis>
    </joint>

    <joint name="front_right_joint" type="revolute">
      <parent>front_right_steering</parent>
      <child>front_right_wheel</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 0 -1</xyz>
      </axis>
    </joint>

    <joint name="rear_left_joint" type="revolute">
      <parent>chassis</parent>
      <child>rear_left_wheel</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 0 -1</xyz>
      </axis>
    </joint>

    <joint name="rear_right_joint" type="revolute">
      <parent>chassis</parent>
      <child>rear_right_wheel</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 0 -1</xyz>
      </axis>
    </joint>

    <!-- ========================================================= -->
    <!-- ACKERMANN STEERING                                        -->
    <!-- ========================================================= -->
    <plugin
      filename="gz-sim-ackermann-steering-system"
      name="gz::sim::systems::AckermannSteering">

      <left_joint>rear_left_joint</left_joint>
      <right_joint>rear_right_joint</right_joint>

      <left_steering_joint>front_left_steering_joint</left_steering_joint>
      <right_steering_joint>front_right_steering_joint</right_steering_joint>

      <wheel_separation>0.68</wheel_separation>
      <wheel_base>0.70</wheel_base>
      <wheel_radius>0.15</wheel_radius>

      <steering_limit>0.5</steering_limit>

      <min_velocity>-1.0</min_velocity>
      <max_velocity>1.0</max_velocity>

      <topic>/cmd_vel</topic>
    </plugin>

    <!-- ========================================================= -->
    <!-- LIDAR                                                     -->
    <!-- ========================================================= -->
    <link name="lidar_link">
      <pose>0.25 0 1.00 0 0 0</pose>

      <sensor name="lidar" type="gpu_lidar">
        <topic>/scan</topic>
        <update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.10</min>
            <max>10.0</max>
            <resolution>0.01</resolution>
          </range>
        </ray>
        <always_on>true</always_on>
        <visualize>true</visualize>
      </sensor>
    </link>

    <joint name="lidar_joint" type="fixed">
      <parent>chassis</parent>
      <child>lidar_link</child>
    </joint>

    <!-- ========================================================= -->
    <!-- IMU                                                       -->
    <!-- ========================================================= -->
    <link name="imu_link">
      <pose>0 0 0.55 0 0 0</pose>

      <sensor name="imu_sensor" type="imu">
        <topic>/imu</topic>
        <always_on>true</always_on>
        <update_rate>50</update_rate>
        <visualize>false</visualize>

        <imu>
          <angular_velocity>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.001</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.001</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.001</stddev>
              </noise>
            </z>
          </angular_velocity>

          <linear_acceleration>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.01</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.01</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.01</stddev>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
      </sensor>
    </link>

    <joint name="imu_joint" type="fixed">
      <parent>chassis</parent>
      <child>imu_link</child>
    </joint>

    <!-- ========================================================= -->
    <!-- CAMERA                                                    -->
    <!-- ========================================================= -->
    <link name="camera_link">
      <pose>0.45 0 0.65 0 0 0</pose>

      <sensor name="camera" type="camera">
        <topic>/camera/image_raw</topic>
        <update_rate>30</update_rate>
        <visualize>true</visualize>

        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>30.0</far>
          </clip>
        </camera>
      </sensor>
    </link>

    <joint name="camera_joint" type="fixed">
      <parent>chassis</parent>
      <child>camera_link</child>
    </joint>

    <!-- ========================================================= -->
    <!-- GPS                                                       -->
    <!-- ========================================================= -->
    <link name="gps_link">
      <pose>0 0 0.75 0 0 0</pose>

      <sensor name="gps_sensor" type="navsat">
        <topic>/gps</topic>
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <visualize>false</visualize>
      </sensor>
    </link>

    <joint name="gps_joint" type="fixed">
      <parent>chassis</parent>
      <child>gps_link</child>
    </joint>
    <plugin
  filename="gz-sim-odometry-publisher-system"
  name="gz::sim::systems::OdometryPublisher">
  <odom_topic>/model/delivery_robot/odometry</odom_topic>
  <frame_id>odom</frame_id>
  <child_frame_id>base_link</child_frame_id>
  <dimensions>3</dimensions>
</plugin>

  </model>
</sdf>