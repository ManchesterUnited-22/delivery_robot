            <box>
              <size>1.3 0.10 1.0</size>
            </box>

          </geometry>

          <material>

            <ambient>0.05 0.25 0.45 1</ambient>

            <diffuse>0.10 0.45 0.70 1</diffuse>

          </material>

        </visual>


        <!-- Window 2 -->

        <visual name="window_2">

          <pose>2.5 2.06 0.35 0 0 0</pose>

          <geometry>

            <box>
              <size>1.3 0.10 1.0</size>
            </box>

          </geometry>

          <material>

            <ambient>0.05 0.25 0.45 1</ambient>

            <diffuse>0.10 0.45 0.70 1</diffuse>

          </material>

        </visual>


        <!-- Library facade columns -->
        <visual name="library_facade_column_left">
          <pose>-3.55 2.06 0 0 0 0</pose>
          <geometry><box><size>0.18 0.12 2.75</size></box></geometry>
          <material><ambient>0.72 0.68 0.58 1</ambient><diffuse>0.88 0.83 0.72 1</diffuse></material>
        </visual>

        <visual name="library_facade_column_right">
          <pose>3.55 2.06 0 0 0 0</pose>
          <geometry><box><size>0.18 0.12 2.75</size></box></geometry>
          <material><ambient>0.72 0.68 0.58 1</ambient><diffuse>0.88 0.83 0.72 1</diffuse></material>
        </visual>

        <!-- Door frame columns -->
        <visual name="library_door_frame_left">
          <pose>-0.88 2.08 -0.05 0 0 0</pose>
          <geometry><box><size>0.12 0.10 2.45</size></box></geometry>
          <material><ambient>0.30 0.34 0.38 1</ambient><diffuse>0.38 0.42 0.46 1</diffuse></material>
        </visual>

        <visual name="library_door_frame_right">
          <pose>0.88 2.08 -0.05 0 0 0</pose>
          <geometry><box><size>0.12 0.10 2.45</size></box></geometry>
          <material><ambient>0.30 0.34 0.38 1</ambient><diffuse>0.38 0.42 0.46 1</diffuse></material>
        </visual>

        <!-- Horizontal facade trim -->
        <visual name="library_facade_upper_trim">
          <pose>0 2.07 1.28 0 0 0</pose>
          <geometry><box><size>7.6 0.12 0.14</size></box></geometry>
          <material><ambient>0.30 0.34 0.38 1</ambient><diffuse>0.38 0.42 0.46 1</diffuse></material>
        </visual>

        <!-- Front entrance steps -->
        <visual name="library_entrance_step_lower">
          <pose>0 2.34 -1.39 0 0 0</pose>
          <geometry><box><size>2.2 0.48 0.12</size></box></geometry>
          <material><ambient>0.48 0.48 0.45 1</ambient><diffuse>0.58 0.58 0.54 1</diffuse></material>
        </visual>

        <visual name="library_entrance_step_upper">
          <pose>0 2.17 -1.31 0 0 0</pose>
          <geometry><box><size>1.8 0.28 0.08</size></box></geometry>
          <material><ambient>0.62 0.62 0.58 1</ambient><diffuse>0.72 0.72 0.68 1</diffuse></material>
        </visual>
      </link>

