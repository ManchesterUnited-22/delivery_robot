          <material>

            <ambient>0.72 0.68 0.58 1</ambient>

            <diffuse>0.86 0.80 0.68 1</diffuse>

          </material>

        </visual>


        <!-- Roof -->

        <visual name="roof">

          <pose>0 0 1.65 0 0 0</pose>

          <geometry>

            <box>
              <size>8.5 4.5 0.35</size>
            </box>

          </geometry>

          <material>

            <ambient>0.18 0.22 0.28 1</ambient>

            <diffuse>0.25 0.30 0.38 1</diffuse>

          </material>

        </visual>


        <!-- Main door -->

